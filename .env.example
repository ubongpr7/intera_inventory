# Django
SECRET_KEY=change-me
DEBUG=True
LOCAL_SERVER=True
DJANGO_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1,dev.inventory.interaims.com,inventory.interaims.com,inventory.mcp.interaims.com
SECURE_SSL_REDIRECT=False
SECURE_PROXY_SSL_HEADER_ENABLED=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=None
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://10.0.2.2:3000,http://10.0.2.2:8080
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://10.0.2.2:3000,http://10.0.2.2:8080
INVENTORY_MCP_ALLOWED_HOSTS=inventory.mcp.interaims.com,inventory.interaims.com,dev.inventory.interaims.com
INVENTORY_MCP_ALLOWED_ORIGINS=https://inventory.mcp.interaims.com,https://dev.interaims.com,https://www.interaims.com,http://localhost:3000

# Database
DB_NAME=intera_inventory
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# JWT verification
# Identity service is the only signer. This service verifies with the public key only.
JWT_ALGORITHM=RS256
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_AUDIENCE=
JWT_ISSUER=
JWT_JWK_URL=

# Celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Optional storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# Optional auth redirects
SOCIAL_AUTH_ALLOWED_REDIRECT_URIS=http://localhost:3000

# Email
EMAIL_BACKEND=django_smtp_ssl.SSLEmailBackend
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=business@example.com
EMAIL_HOST_PASSWORD=your-hostinger-mailbox-password
DEFAULT_FROM_EMAIL=Intera IMS <noreply@interaims.com>
EMAIL_SYSTEM_FROM_EMAIL=Intera IMS <noreply@interaims.com>
EMAIL_AGENT_FROM_EMAIL=Intera Agent <intera-agent@interaims.com>
EMAIL_DEFAULT_REPLY_TO=support@interaims.com
FRONTEND_SITE_URL=http://localhost:3000
# Required only for PURCHASE_ORDER_EMAIL_DELIVERY_MODE or RETURN_ORDER_EMAIL_DELIVERY_MODE
# set to shadow or notification_service.
# This must be the externally reachable inventory API base URL, not the frontend URL.
NOTIFICATION_DOCUMENT_BASE_URL=
NOTIFICATION_DOCUMENT_SIGNING_SALT=replace-with-a-secret-per-environment
NOTIFICATION_DOCUMENT_URL_TTL_SECONDS=900
# Roll out as direct -> shadow -> notification_service after reconciliation.
PURCHASE_ORDER_EMAIL_DELIVERY_MODE=direct
RETURN_ORDER_EMAIL_DELIVERY_MODE=direct
EMAIL_BRAND_LOGO_URL=
EMAIL_SHARED_STATIC_BUCKET=interabucket
EMAIL_SHARED_STATIC_LOCATION=assessment/static
EMAIL_BRAND_LOGO_LIGHT_URL=
EMAIL_BRAND_LOGO_DARK_URL=
EMAIL_SUPPORT_EMAIL=support@interaims.com

# Cross-service data should arrive through Kafka projections, not HTTP service URLs.

# Kafka
KAFKA_SERVICE_NAME=inventory
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CA_FILE=
KAFKA_SSL_CERT_FILE=
KAFKA_SSL_KEY_FILE=
KAFKA_SSL_KEY_PASSWORD=
KAFKA_CONSUMER_GROUP=inventory-consumer
KAFKA_CONSUMER_TOPICS=identity.user,identity.company_profile,identity.membership,catalog.product,catalog.variant,pos.order
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_POLL_INTERVAL=1.0
KAFKA_REQUEST_TIMEOUT_MS=10000
KAFKA_MESSAGE_TIMEOUT_MS=10000
KAFKA_SESSION_TIMEOUT_MS=10000
KAFKA_HEARTBEAT_INTERVAL_MS=3000
KAFKA_PRODUCER_LINGER_MS=5
KAFKA_PRODUCER_ACKS=all
# Purchase-order and return-order notification dispatches always use the durable
# outbox. This setting still controls unrelated generic inventory events.
KAFKA_USE_OUTBOX=false
KAFKA_ENABLE_CONSUMER_IDEMPOTENCY=true
KAFKA_ENABLE_DLQ=true
KAFKA_COMMIT_FAILED_MESSAGES=true
KAFKA_DLQ_SUFFIX=.dlq
KAFKA_OUTBOX_BATCH_SIZE=100
KAFKA_OUTBOX_POLL_INTERVAL=2.0
KAFKA_OUTBOX_RETRY_DELAY_SECONDS=30

# For authenticated brokers, switch KAFKA_SECURITY_PROTOCOL to SASL_PLAINTEXT or SASL_SSL
# and set the SASL/SSL variables above.
